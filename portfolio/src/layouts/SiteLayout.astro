---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="en" data-site-effects="on">
  <head>
    <BaseHead title={title} description={description} canonicalPath={canonicalPath} />
  </head>
  <body>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <div class="cursor-orbit" aria-hidden="true"><span></span></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
